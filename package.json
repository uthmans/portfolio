{
  "name": "uthman-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/verify-build.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test:browser": "node scripts/check-browser.mjs",
    "test": "node --test tests/*.test.ts server/*.test.mjs worker/*.test.mjs",
    "worker:dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "worker:check": "wrangler deploy --dry-run --outdir /tmp/portfolio-worker-bundle",
    "worker:test": "node scripts/check-worker-runtime.mjs",
    "test:feedback": "node scripts/check-feedback.mjs",
    "test:survey": "node scripts/check-survey.mjs",
    "test:business": "node scripts/check-business.mjs",
    "test:hub": "node scripts/check-hub.mjs",
    "test:hub-planner": "node scripts/check-hub-planner.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/manrope": "^5.2.8",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "axe-core": "^4.14.0",
    "playwright": "^1.64.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "wrangler": "4.151.2"
  },
  "overrides": {
    "rollup": "https://registry.npmjs.org/rollup/-/rollup-4.64.6.tgz"
  }
}
