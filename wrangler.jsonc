{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "vars": {
    "SURVEY_ALLOWED_ORIGIN": "https://uthmans.github.io",
    "SURVEY_AI_MODEL": "gpt-4.1-mini"
  },
  "durable_objects": {
    "bindings": [{ "name": "FEEDBACK_QUOTA", "class_name": "FeedbackQuota" }]
  },
  "migrations": [{ "tag": "v1-feedback-quota", "new_sqlite_classes": ["FeedbackQuota"] }],
  "observability": { "enabled": false }
}
